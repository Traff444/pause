# Use "/" for a root domain and "/REPOSITORY_NAME/" for a GitHub Pages project site.
VITE_BASE_PATH=/

# Safe public browser values from Supabase > Project Settings > API.
# Never put service_role or a database password in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
